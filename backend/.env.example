# ====================================================
# Skill2Career Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ====================================================

# ─────── Flask & Security ──────────────────────────
# Secret key for Flask sessions and security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# JWT token signing secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Flask environment (development or production)
FLASK_ENV=development

# ─────── MongoDB Connection ────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=

# Database name
MONGO_DB_NAME=skill2career

# ─────── Google Gemini AI ──────────────────────────
# Google Gemini API Key for AI-powered guidance
# Get this from: https://aistudio.google.com/app/apikey
# Required for: AI mentor, career guidance, resume review
GEMINI_API_KEY=

# ─────── Optional Configuration ────────────────────
# Admin key for protected admin endpoints (set strong random value)
# ADMIN_KEY=

# Server port (default: 5000)
# PORT=5000

# CORS allowed origins (comma-separated, for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
